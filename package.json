{
  "name": "pr-story",
  "version": "0.1.0",
  "description": "Storytelling code review: an ordered, stepper-driven narrative for pull requests, built on the git protocol.",
  "type": "module",
  "bin": {
    "pr-story": "bin/pr-story.mjs"
  },
  "files": [
    "bin",
    "src",
    "web/dist"
  ],
  "scripts": {
    "build:ui": "npm --prefix web install && npm --prefix web run build",
    "build": "npm run build:ui",
    "prepare": "npm run build:ui || true",
    "test": "node --test test/"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^12.1.0",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "parse-diff": "^0.11.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
